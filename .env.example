DATABASE_URL="postgresql://ukos:ukos@localhost:5432/ukos?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"

# URL canónica en la barra del navegador (esquema + host; sin :puerto si usas Caddy en 80/443).
# Recomendado en tailnet: https://ukos.com (Split DNS → VM + Caddy → contenedor :3000). Ver tailscale/apply-ukos-internal-dns-proxy.sh.
UKOS_PUBLIC_BASE_URL="https://ukos.com"

# Solo si corres Next sin Docker: deben coincidir con UKOS_PUBLIC_BASE_URL.
NEXTAUTH_URL="https://ukos.com"
APP_URL="https://ukos.com"

DEFAULT_COMPANY_SLUG="ukos-demo"
